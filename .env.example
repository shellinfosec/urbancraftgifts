# ==============================================================================
# Urban Craft & Co. - Environment Configuration Template
# ==============================================================================

# Cloudflare Turnstile Bot Defense
# Get these from Cloudflare Dashboard > Turnstile
CF_TURNSTILE_SITE_KEY=0x4AAAAAAFx...
CF_TURNSTILE_SECRET=0x4AAAAAAFx...
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFx...
TURNSTILE_SECRET=0x4AAAAAAFx...
# Set to 'true' to bypass verification during testing
TURNSTILE_BYPASS=false

# API Endpoints
VITE_INQUIRY_ENDPOINT=/api/inquire
VITE_CONTACT_ENDPOINT=/api/contact

# SMTP Outbound Email Credentials
SMTP_HOST=s782.bom1.mysecurecloudhost.com
SMTP_PORT=465
SMTP_USERNAME=notifications@urbancraftgifts.com
SMTP_PASS=your_strong_smtp_password
SENDER_EMAIL=notifications@urbancraftgifts.com
RECIPIENT_EMAIL=info@urbancraftgifts.com
SSL_SECURE=YES

# Server Configuration
PORT=3001
NODE_ENV=production
ALLOWED_ORIGINS=https://urbancraftgifts.com,https://www.urbancraftgifts.com,https://demo.urbancraftgifts.com
ADMIN_SECRET_KEY=optional_super_secret_diagnostics_token
